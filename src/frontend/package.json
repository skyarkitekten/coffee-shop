{
  "name": "coffee-shop-frontend",
  "version": "1.0.0",
  "description": "Frontend web application for Coffee Shop tradesperson profile management",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write src/**/*.{vue,ts,js,json,css,scss}",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@azure/msal-browser": "^4.25.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vueuse/core": "^13.9.0",
    "axios": "^1.6.0",
    "eslint": "^9.37.0",
    "pinia": "^3.0.3",
    "vee-validate": "^4.11.8",
    "vue": "^3.3.8",
    "vue-router": "^4.2.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.8.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "@vue/test-utils": "^2.4.2",
    "@vue/tsconfig": "^0.8.1",
    "eslint-plugin-vue": "^10.5.1",
    "jsdom": "^27.0.0",
    "prettier": "^3.0.3",
    "sass": "^1.69.5",
    "typescript": "^5.2.2",
    "vite": "^7.1.10",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.1"
  },
  "keywords": [
    "vue",
    "typescript",
    "vite",
    "tradesperson",
    "profile",
    "management"
  ],
  "author": "Coffee Shop Development Team",
  "license": "MIT"
}
